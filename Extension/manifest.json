{
  "manifest_version": 3,
  "name": "Superbrowser Helper",
  "version": "1.0",
  "description": "Tells the Superbrowser app which Chrome windows belong to this profile.",
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["storage", "alarms"],
  "host_permissions": ["http://127.0.0.1:47321/*"],
  "content_scripts": [
    {
      "matches": ["http://127.0.0.1:47321/claim*"],
      "js": ["claim.js"],
      "run_at": "document_start"
    }
  ]
}
